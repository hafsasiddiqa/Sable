generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  name      String
  email     String   @unique
  role      String?
  createdAt DateTime @default(now())

  meetings  Meeting[]
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  duration    String
  status      String
  transcript  String
  summary     String
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  actionItems ActionItem[]
  createdAt   DateTime @default(now())
}

model ActionItem {
  id        String   @id @default(cuid())
  text      String
  status    String   @default("todo")
  assignee  String
  dueDate   String
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  createdAt DateTime @default(now())
}
